<style>
:root {
  --navy:#20364d;
  --darknavy:#142638;
  --gold:#c9a54a;
  --rust:#a64b2a;
  --paper:#f4f0e7;
  --cream:#fbf8f1;
  --ink:#1c2430;
  --grey:#66717a;
  --line:#c8c2b8;
  --green:#58705a;
  --blue:#416a88;
}

*{box-sizing:border-box}

body{
  margin:0;
  font-family:Arial,Helvetica,sans-serif;
  color:var(--ink);
  background:
    linear-gradient(rgba(244,240,231,.96),rgba(244,240,231,.96)),
    repeating-linear-gradient(0deg,transparent 0 31px,rgba(0,0,0,.03) 32px);
}

.top-strip{
  background:var(--darknavy);
  color:#dce5ea;
  padding:8px 5%;
  font-size:12px;
  letter-spacing:2px;
  text-transform:uppercase;
}

header{
  background:linear-gradient(120deg,var(--navy),#31546a);
  color:white;
  border-bottom:6px solid var(--gold);
}

.header-inner{
  max-width:1150px;
  margin:auto;
  padding:38px 25px 34px;
}

.case-label{
  color:#ecdca8;
  font-size:13px;
  letter-spacing:3px;
  text-transform:uppercase;
  font-weight:bold;
}

header h1{
  font-family:Georgia,serif;
  font-size:55px;
  margin:8px 0 4px;
}

header p{
  margin:0;
  font-size:17px;
}

nav{
  background:white;
  border-bottom:1px solid var(--line);
  box-shadow:0 2px 10px rgba(0,0,0,.08);
  position:sticky;
  top:0;
  z-index:20;
}

.nav-inner{
  max-width:1150px;
  margin:auto;
  display:flex;
  overflow-x:auto;
  padding:8px 15px;
}

nav a{
  text-decoration:none;
  color:var(--navy);
  font-size:14px;
  font-weight:bold;
  padding:10px 13px;
  border-radius:6px;
  white-space:nowrap;
}

nav a:hover{background:#edf1f2}
nav a.active{background:var(--navy);color:white}

main{
  max-width:1150px;
  margin:auto;
  padding:25px 20px 50px;
}

.back{
  display:inline-block;
  text-decoration:none;
  color:var(--navy);
  font-weight:bold;
  margin-bottom:15px;
}

.instruction{
  background:#fff8f2;
  border:1px solid #dfb6a5;
  border-left:6px solid var(--rust);
  padding:15px 18px;
  border-radius:8px;
  margin-bottom:22px;
}

.instruction strong{color:var(--rust)}

.section-heading{
  margin:28px 0 14px;
}

.section-heading small{
  display:block;
  color:var(--rust);
  font-size:12px;
  font-weight:bold;
  letter-spacing:2px;
  text-transform:uppercase;
}

.section-heading h2{
  font-family:Georgia,serif;
  color:var(--navy);
  font-size:31px;
  margin:5px 0;
}

.exhibit-grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:18px;
}

.exhibit{
  background:#fff;
  border:1px solid var(--line);
  border-radius:12px;
  box-shadow:0 4px 14px rgba(0,0,0,.06);
  overflow:hidden;
}

.exhibit-head{
  background:var(--navy);
  color:white;
  padding:14px 16px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:12px;
}

.exhibit-head strong{
  font-family:Georgia,serif;
  font-size:20px;
}

.exhibit-label{
  background:var(--gold);
  color:#1f2933;
  padding:5px 8px;
  border-radius:999px;
  font-size:11px;
  font-weight:bold;
  letter-spacing:1px;
  text-transform:uppercase;
}

.exhibit-body{
  padding:16px;
}

.exhibit-body p{line-height:1.45}

details{
  border-top:1px solid var(--line);
  margin-top:14px;
  padding-top:12px;
}

summary{
  cursor:pointer;
  font-weight:bold;
  color:var(--navy);
}

.note{
  background:var(--cream);
  border-left:4px solid var(--gold);
  padding:10px 12px;
  margin-top:12px;
}

.find{
  background:#eef4f7;
  border-left:4px solid var(--blue);
  padding:10px 12px;
  margin-top:12px;
}

.question{
  background:#f3efe5;
  border-left:4px solid var(--rust);
  padding:10px 12px;
  margin-top:12px;
}

/* Floor plan */
.floorplan{
  display:grid;
  grid-template-columns:1.2fr .9fr .9fr;
  grid-template-rows:90px 90px;
  gap:6px;
  background:#263845;
  padding:6px;
  margin:12px 0;
  border-radius:6px;
}

.room{
  background:#faf7ef;
  display:flex;
  align-items:center;
  justify-content:center;
  text-align:center;
  padding:8px;
  font-weight:bold;
  color:var(--navy);
  position:relative;
}

.office{grid-row:1 / 3}
.meeting{grid-column:2 / 4}
.store{grid-column:2}
.entry{grid-column:3}

.camera{
  position:absolute;
  top:5px;
  right:6px;
  font-size:13px;
  color:var(--rust);
}

/* CCTV */
.log{
  width:100%;
  border-collapse:collapse;
  font-size:14px;
}

.log th,.log td{
  border:1px solid var(--line);
  padding:8px;
  text-align:left;
}

.log th{
  background:#e8edf0;
  color:var(--navy);
}

/* bank */
.bank{
  border:1px solid #b7c3ca;
  background:#f8fbfc;
  border-radius:8px;
  padding:14px;
  font-family:Arial,Helvetica,sans-serif;
}

.bank-top{
  display:flex;
  justify-content:space-between;
  border-bottom:2px solid var(--blue);
  padding-bottom:9px;
  margin-bottom:10px;
}

.bank-row{
  display:grid;
  grid-template-columns:1fr 1fr 1fr 1fr;
  gap:6px;
  padding:8px 0;
  border-bottom:1px solid #d9e1e5;
  font-size:13px;
}

.bank-row.head{font-weight:bold;color:var(--navy)}
.negative{color:#a12f2f;font-weight:bold}

/* meeting */
.minutes{
  border:1px solid #c8c2b8;
  background:#fffdf7;
  padding:14px;
  font-family:Georgia,serif;
}

.minutes h3{margin:0 0 8px;color:var(--navy)}
.minutes ul{margin-bottom:0}

/* email */
.email{
  border:1px solid #b7bcc0;
  background:#fff;
  border-radius:7px;
  overflow:hidden;
}

.email-line{
  padding:8px 10px;
  border-bottom:1px solid #e1e4e6;
  font-size:13px;
}

.email-body{
  padding:14px;
  line-height:1.5;
}

.flag{
  background:#fff1eb;
  border:1px solid #e2b49f;
  color:#8d3e27;
  padding:8px 10px;
  border-radius:6px;
  margin-top:10px;
  font-size:13px;
}

/* messages */
.phone{
  max-width:360px;
  margin:8px auto;
  background:#20282e;
  border-radius:22px;
  padding:12px;
  color:white;
}

.screen{
  background:#eef2f3;
  color:#1c2430;
  border-radius:14px;
  padding:12px;
}

.bubble{
  max-width:80%;
  padding:8px 10px;
  border-radius:12px;
  margin:8px 0;
  font-size:13px;
  line-height:1.35;
}

.left{background:white}
.right{background:#cfe4d0;margin-left:auto}

.taskbox{
  margin-top:28px;
  background:var(--darknavy);
  color:white;
  border-radius:12px;
  padding:22px;
}

.taskbox h2{
  font-family:Georgia,serif;
  margin-top:0;
}

.task-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:12px;
  margin-top:14px;
}

.task-mini{
  background:rgba(255,255,255,.08);
  border:1px solid rgba(255,255,255,.14);
  padding:13px;
  border-radius:8px;
}

footer{
  background:#ded8cc;
  border-top:1px solid var(--line);
  padding:22px;
  text-align:center;
  color:#59626a;
  font-size:13px;
}

@media(max-width:850px){
  .exhibit-grid,.task-grid{grid-template-columns:1fr}
}

@media(max-width:600px){
  header h1{font-size:40px}
  .floorplan{grid-template-columns:1fr;grid-template-rows:auto}
  .office,.meeting,.store,.entry{grid-column:auto;grid-row:auto;min-height:70px}
  .bank-row{grid-template-columns:1fr 1fr}
}
</style>
</head>

